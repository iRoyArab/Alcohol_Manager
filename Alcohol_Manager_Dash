def rvfm_tag(rvfm_value):
    """תג VFM לפי ציון RVFM"""
    vfm_val = float(rvfm_value)
    if vfm_val > 9:
        return "🟢 מציאה"
    elif vfm_val > 7.5:
        return "🟢 שווה"
    elif vfm_val > 6.8:
        return "🟡 הוגן"
    elif vfm_val > 5.5:
        return "🟠 יקר יחסית"
    else:
        return "🔴 לא שווה"


import numpy as np
#0.2 Auto Sweet-Rich Fill
@app.callback(
    [
        Output('sweet_score', 'value'),
        Output('rich_score', 'value'),
        Output('finish_strength_score', 'value'),
        Output('finish_length_score', 'value')
    ],
    [
        Input('new-nose-dropdown', 'value'),
        Input('new-palette-dropdown', 'value'),
        Input('new-abv', 'value'),
        Input('new-bottle_name-dropdown', 'value'),
        Input('new-distillery-dropdown', 'value')
    ],
    prevent_initial_call=True
)

def sweet_rich_auto_fill(nose, palette, abv, bottle_name, distillery):

    # ── Step 0: Check if bottle exists in DF (pull scores directly) ────────────
    try:
        all_df = get_all_data_as_df()
        if bottle_name and distillery and not all_df.empty:
            match = all_df[
                (all_df['bottle_name'] == bottle_name) &
                (all_df['distillery'] == distillery)
            ]
            if not match.empty:
                row = match.iloc[0]
                s_score = row.get('final_smoky_sweet_score') if hasattr(row, 'get') else row['final_smoky_sweet_score']
                r_score = row.get('final_richness_score') if hasattr(row, 'get') else row['final_richness_score']
                fs_score = row.get('finish_strength_score') if hasattr(row, 'get') else row['finish_strength_score']
                fl_score = row.get('finish_length_score') if hasattr(row, 'get') else row['finish_length_score']
                fs_label = row.get('Est_Finish_Strength') if hasattr(row, 'get') else row['Est_Finish_Strength']
                fl_label = row.get('Est_Finish_Length') if hasattr(row, 'get') else row['Est_Finish_Length']

                sweet_out = f"{get_sweetness_label(float(s_score))} - {round(float(s_score), 3)}" if s_score is not None else None
                rich_out  = f"{get_richness_label(float(r_score))} - {round(float(r_score), 3)}" if r_score is not None else None
                fs_out    = f"{fs_label} - {round(float(fs_score), 3)}" if fs_score is not None and fs_label else None
                fl_out    = f"{fl_label} - {round(float(fl_score), 3)}" if fl_score is not None and fl_label else None
                return sweet_out, rich_out, fs_out, fl_out
    except Exception:
        pass

    # ── Step 1: Merge & parse ──────────────────────────────────────────────────
    raw_inputs = (nose or []) + (palette or [])
    parsed_flavors = list({
        f.strip()
        for entry in raw_inputs
        for f in entry.split(',')
        if f.strip()
    })

    if not parsed_flavors:
        return 0, 0, None, None

    unique_flavor_count = len(parsed_flavors)

    # ── Step 2: Filter flavor master ──────────────────────────────────────────
    matched_df = flavors_df[flavors_df['flavor_name'].isin(parsed_flavors)].copy()

    # Zero matches at all → unknown
    if matched_df.empty:
        return 'Unknown Flavors', 'Unknown Flavors', None, None
    
    if not abv:
        return 'ABV Missing', 'ABV Missing', None, None

    # Partial matches → silently skip unmatched, use only what exists
    # unique_flavor_count stays as the full parsed list length (same as SQL COUNT DISTINCT)
    
    # ── Step 3: Raw averages ───────────────────────────────────────────────────
    raw_richness    = matched_df['richness_score'].mean()
    raw_smoky_sweet = matched_df['smoky_sweet_score'].mean()

    # ── Step 4: Boolean flags ─────────────────────────────────────────────────
    scores     = matched_df['richness_score'].to_numpy()
    flavor_set = set(matched_df['flavor_name'])

    rich          = np.where(scores == 8.0, True, False).any()
    super_rich    = np.where(scores == 9.0, True, False).any()
    rich_joker    = bool({'butterscotch', 'Marmalade','Chocolate','Coffee','Espresso'}                       & flavor_set)
    bitter_flavor = bool({'Dark Chocolate', 'Coffee', 'Mocha','Espresso', 'Tiramisu'}  & flavor_set)
    light_smoke   = bool({'Minerals', 'Sulfur', 'Meaty', 'Chalk', 'Metalic'} & flavor_set)

    # ── Step 5: PenalizedStats ────────────────────────────────────────────────
    base_richness = (
        (raw_richness * 0.7 if unique_flavor_count < 4 else raw_richness)
        * (1.3  if rich        else 1.0)
        * (1.55 if super_rich  else 1.0)
        * (1.4  if rich_joker  else 1.0)
    )
    base_smoky_sweet = (
        (raw_smoky_sweet * 0.7 if unique_flavor_count <= 4 else raw_smoky_sweet)
        * (1.25 if bitter_flavor else 1.0)
        * (1.4  if light_smoke   else 1.0)
    )

    # ── Step 6: ABV multipliers ────────────────────────────────────────────────
    abv = float(abv) if abv else 0.0

    if 40 <= abv <= 47.99:
        final_richness = base_richness * 0.9
    elif 48 <= abv <= 53.99:
        final_richness = base_richness * 1.1
    elif 54 <= abv <= 58.99:
        final_richness = base_richness * 1.25
    elif 59 <= abv <= 64.99:
        final_richness = base_richness * 1.4
    elif 65 <= abv <= 70.99:
        final_richness = base_richness * 1.5
    else:
        final_richness = base_richness

    if 40 <= abv <= 46.99:
        final_smoky_sweet = base_smoky_sweet * 0.7
    elif 47 <= abv <= 53.99:
        final_smoky_sweet = base_smoky_sweet * 0.8 if base_smoky_sweet < 5 else base_smoky_sweet * 1.1
    elif 54 <= abv <= 58.99:
        final_smoky_sweet = base_smoky_sweet * 0.75 if base_smoky_sweet < 5 else base_smoky_sweet * 1.2
    elif 59 <= abv <= 64.99:
        final_smoky_sweet = base_smoky_sweet * 0.65 if base_smoky_sweet < 5 else base_smoky_sweet * 1.45
    elif 65 <= abv <= 70.99:
        final_smoky_sweet = base_smoky_sweet * 0.55 if base_smoky_sweet < 5 else base_smoky_sweet * 1.5
    else:
        final_smoky_sweet = base_smoky_sweet

    def get_sweetness_label(score: float) -> str:
        items = list(SWEETNESS_RANGES.items())
        for i, (label, (low, high)) in enumerate(items):
            if i < len(items) - 1:
                if low <= score <= high:  # שינוי: < הפך ל-<=
                    return label
            else:
                if low <= score <= high:
                    return label
        return "Out of range"
    
    def get_richness_label(score: float) -> str:
        for label, (low, high) in RICHNESS_RANGES.items():
            if low <= score <= high:
                return label
        return "Out of range"
    

    sweet_label = get_sweetness_label(final_smoky_sweet)
    rich_label = get_richness_label(final_richness)
    
    final_sweet_label = f"{sweet_label} - {round(final_smoky_sweet,3)}"
    final_rich_label = f"{rich_label} - {round(final_richness,3)}"

    # ── Step 7: Finish scores (normalized against DF range) ───────────────────
    try:
        all_df = get_all_data_as_df()
        if not all_df.empty and 'final_richness_score' in all_df.columns:
            min_r = all_df['final_richness_score'].min()
            max_r = all_df['final_richness_score'].max()
            norm_richness = (final_richness - min_r) / (max_r - min_r) * 9 + 1 if max_r != min_r else 5.0
        else:
            norm_richness = final_richness
    except Exception:
        norm_richness = final_richness

    # Raw finish scores
    finish_strength_raw = (
        (norm_richness * 0.6)
        + (abs(final_smoky_sweet - 5) * 0.4)
        + (float(abv) - 40) * 0.05
        + np.log(unique_flavor_count + 1) * 0.3
    )
    finish_length_raw = (
        (norm_richness * 0.7)
        + (max(final_smoky_sweet - 5, 0) * 0.5)
        - (max(5 - final_smoky_sweet, 0) * 0.2)
        + (float(abv) - 40) * 0.03
        + np.log(unique_flavor_count + 1) * 0.6
    )

    # Normalize finish scores against DF ranges
    try:
        if not all_df.empty and 'finish_strength_score' in all_df.columns:
            min_fs = all_df['finish_strength_score'].min()
            max_fs = all_df['finish_strength_score'].max()
            min_fl = all_df['finish_length_score'].min()
            max_fl = all_df['finish_length_score'].max()
            finish_strength_norm = (finish_strength_raw - min_fs) / (max_fs - min_fs) * 9 + 1 if max_fs != min_fs else 5.0
            finish_length_norm   = (finish_length_raw  - min_fl) / (max_fl - min_fl) * 9 + 1 if max_fl != min_fl else 5.0
        else:
            finish_strength_norm = max(1, min(10, finish_strength_raw))
            finish_length_norm   = max(1, min(10, finish_length_raw))
    except Exception:
        finish_strength_norm = max(1, min(10, finish_strength_raw))
        finish_length_norm   = max(1, min(10, finish_length_raw))

    finish_strength_norm = round(max(1.0, min(10.0, finish_strength_norm)), 3)
    finish_length_norm   = round(max(1.0, min(10.0, finish_length_norm)), 3)

    def get_finish_strength_label(score: float) -> str:
        if score >= 9:   return 'Intense'
        elif score >= 7: return 'Strong'
