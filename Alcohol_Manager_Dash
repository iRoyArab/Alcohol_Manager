    State('som-step-store', 'data'),
    prevent_initial_call=True,
)
def som_navigate(*args):
    triggered = ctx.triggered_id
    _show = {'display': 'block'}
    _hide = {'display': 'none'}

    step_map = {
        'som-btn-1': 2,
        'som-btn-2': 3,
        'som-btn-3': 4,
        'som-btn-4': 5,
        'som-reset-btn': 1,
    }
    new_step = step_map.get(triggered, 1)
    progress = {1: 0, 2: 25, 3: 50, 4: 75, 5: 100}.get(new_step, 0)
    step_label = f"Step {new_step} of 4" if new_step <= 4 else "Complete!"
    styles = [_show if i == new_step else _hide for i in range(1, 6)]

    _base_card = {'transition': 'all .15s', 'height': '100%'}
    _base_abv  = {'transition': 'all .15s', 'minHeight': '64px', 'height': '100%'}
    _abv_count = 6

    if triggered == 'som-reset-btn':
        empty_flavor_fig   = _build_sommelier_wheel(_FLAVOR_CATS, [], _FLAVOR_COLORS)
        empty_body_fig     = _build_sommelier_wheel(_BODY_CATS,   [], _BODY_COLORS)
        empty_flavor_badges = _make_badges(_FLAVOR_CATS, [], 'som-flavor-badge')
        empty_body_badges   = _make_badges(_BODY_CATS,   [], 'som-body-badge')
        abv_colors = ['secondary'] * _abv_count
        abv_styles = [_base_abv]   * _abv_count
        return (
            *styles, new_step, progress, step_label,
            'secondary', 'secondary',          # card colors
            _base_card, _base_card,             # card styles
            None, [], [], [],                   # type/flavor/body/abv stores
            empty_flavor_fig, empty_body_fig,   # reset wheel figures
            empty_flavor_badges, empty_body_badges,  # reset badges
            *abv_colors, *abv_styles,           # reset ABV cards
            True, True, True, True,             # disable all continue buttons
        )
    else:
        nu = no_update
        return (
            *styles, new_step, progress, step_label,
            nu, nu, nu, nu, nu, nu, nu, nu, nu, nu, nu, nu,
            *([nu] * _abv_count), *([nu] * _abv_count),
            nu, nu, nu, nu,
        )


