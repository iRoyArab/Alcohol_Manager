# AROMA WHEEL — Plotly polar bar chart (interactive)
# ══════════════════════════════════════════════════════════════════════════════

# Category order around the wheel (clockwise)
CAT_ORDER = [
    'Sweet & Dessert',
    'Fruits',
    'Floral',
    'Spices & Herbs',
    'Nuts',
    'Coffee & Mocha',
    'Wine & Sherry',
    'Earthy - Smoky',
]

# Sort direction within each category:
# 'asc'  = light → rich (richness ascending)
# 'desc' = rich → light (richness descending)
# Alternating so adjacent categories connect smoothly (wave effect)
CAT_SORT = {
    'Sweet & Dessert':      'asc',   # ends rich (Chocolate) → connects to Fruits which starts rich
    'Fruits':               'desc',  # starts rich (Figs), ends light (Green Apples)
    'Floral':               'asc',   # starts light (Flowers), ends rich (Orange Blossom)
    'Spices & Herbs':       'desc',  # starts rich (Pepper), ends light (Mint)
    'Nuts':                 'asc',   # starts light (Coconut), ends rich (Chestnuts)
    'Coffee & Mocha':       'desc',  # starts rich (Mocha), ends light (Coffee)
    'Wine & Sherry':        'asc',   # starts light (White Wine), ends rich (Sherry)
    'Earthy - Smoky': 'desc',  # starts rich (Oak/Tabac), ends light (Minerals)
}

# Color stops — same palette used elsewhere in the app (smoky_sweet badge)
_WHEEL_COLOR_STOPS = [
    (1.0,  "#ffb6c1"),
    (1.9,  "#ffcccb"),
    (2.3,  "#ffcc99"),
    (2.7,  "#ffdb58"),
    (3.9,  "#d4a017"),
    (5.0,  "#228b22"),
    (6.9,  "#a9a9a9"),
    (10.9, "#444444"),
]

def _wheel_cat_color(cat: str) -> str:
    """Map category to a color by spreading CAT_ORDER evenly across the stop range."""
    n = len(CAT_ORDER)
    try:
        idx = CAT_ORDER.index(cat)
    except ValueError:
        return '#6c757d'
    score = _WHEEL_COLOR_STOPS[0][0] + (idx / max(n - 1, 1)) * (
        _WHEEL_COLOR_STOPS[-1][0] - _WHEEL_COLOR_STOPS[0][0]
    )
    return _lerp_color_by_stops(score, _WHEEL_COLOR_STOPS)

# Pre-build lookup dict
CATEGORY_COLORS = {cat: _wheel_cat_color(cat) for cat in CAT_ORDER}
_DEFAULT_CATEGORY_COLOR = '#6c757d'

def get_category_color_by_name(category: str) -> str:
    return CATEGORY_COLORS.get(category, _DEFAULT_CATEGORY_COLOR)

def build_aroma_wheel_figure(flavors, nose_selected, palette_selected):
    """
    Clean aroma wheel:
    - No individual flavor names on the wheel
    - Category labels only around the perimeter, positioned next to their flavors
    - Full flavor name + category shown on hover
    - Tri-color selection: blue=nose, purple=palette, gold=both
    - Category derived from flavor_category field (flavor_master_mapping)
    """
    import plotly.graph_objects as go
    import math

    if not flavors:
        return go.Figure()

    nose_set     = set(nose_selected or [])
    palette_set  = set(palette_selected or [])
    both_set     = nose_set & palette_set
    nose_only    = nose_set - both_set
    palette_only = palette_set - both_set
    all_selected = nose_set | palette_set

    # Group by category, sort within each group by richness per CAT_SORT direction,
    # then assemble in CAT_ORDER → creates the wave effect between categories
    from collections import defaultdict as _dd
    _cat_buckets = _dd(list)
    for f in flavors:
        _cat_buckets[f.get('flavor_category', '')].append(f)

    for cat in _cat_buckets:
        reverse = CAT_SORT.get(cat, 'asc') == 'desc'
        _cat_buckets[cat].sort(key=lambda x: x.get('richness_score', 5), reverse=reverse)

    flavors_sorted = []
    for cat in CAT_ORDER:
        flavors_sorted.extend(_cat_buckets.get(cat, []))
    # append any unknown categories at the end
    for cat, fs in _cat_buckets.items():
        if cat not in CAT_ORDER:
            flavors_sorted.extend(fs)
    n = len(flavors_sorted)
    if n == 0:
        return go.Figure()

    angle_step = 360 / n
    thetas   = [i * angle_step for i in range(n)]
    widths   = [angle_step * 0.82] * n
    names    = [f['flavor_name'] for f in flavors_sorted]
    richness = [max(2.0, f.get('richness_score', 5)) for f in flavors_sorted]
    smoky    = [f.get('smoky_sweet_score', 5) for f in flavors_sorted]
    cats     = [f.get('flavor_category', '') for f in flavors_sorted]

    # Selection colors
    SEL_NOSE    = '#4C9BE8'
    SEL_PALETTE = '#A855F7'
    SEL_BOTH    = '#F59E0B'

    def get_bar_color(name, cat):
        if name in both_set:     return SEL_BOTH
        if name in nose_only:    return SEL_NOSE
        if name in palette_only: return SEL_PALETTE
        return get_category_color_by_name(cat)

    colors      = [get_bar_color(nm, cat) for nm, cat in zip(names, cats)]
    line_colors = ['#92600A' if nm in both_set else
                   '#1a5fa8' if nm in nose_only else
                   '#6b21a8' if nm in palette_only else
                   'rgba(255,255,255,0.4)' for nm in names]
    line_widths = [2.5 if nm in all_selected else 0.5 for nm in names]

    # Hover: show name + category
    hover_texts = [
        f'<b>{nm}</b><br>Category: {cat}<br>Richness: {r:.0f}/10'
        for nm, cat, r in zip(names, cats, richness)
    ]

    fig = go.Figure()

    # ── Main bars ─────────────────────────────────────────────────────────────
    fig.add_trace(go.Barpolar(
        r=richness,
        theta=thetas,
        width=widths,
        marker=dict(
            color=colors,
            line=dict(color=line_colors, width=line_widths),
            opacity=[1.0 if nm in all_selected else 0.85 for nm in names],
        ),
        customdata=list(zip(names, cats)),
        hovertemplate='%{text}<extra></extra>',
        text=hover_texts,
        name='',
    ))

    # ── Glow ring for selected ────────────────────────────────────────────────
    for sel_set, glow_fill, glow_border in [
        (both_set,    'rgba(245,158,11,0.25)', '#F59E0B'),
        (nose_only,   'rgba(76,155,232,0.25)', '#4C9BE8'),
        (palette_only,'rgba(168,85,247,0.25)', '#A855F7'),
    ]:
        if sel_set:
            s_idx    = [i for i, nm in enumerate(names) if nm in sel_set]
            s_thetas = [thetas[i] for i in s_idx]
            s_r      = [richness[i] + 1.4 for i in s_idx]
            s_names  = [names[i] for i in s_idx]
            s_cats   = [cats[i] for i in s_idx]
            s_hover  = [f'<b>{nm}</b> ✓<br>{cat}' for nm, cat in zip(s_names, s_cats)]
            fig.add_trace(go.Barpolar(
                r=s_r,
                theta=s_thetas,
                width=[angle_step * 0.82] * len(s_thetas),
                marker=dict(color=glow_fill, line=dict(color=glow_border, width=1.5)),
                hovertemplate='%{text}<extra></extra>',
                text=s_hover,
                name='',
            ))

    # ── Category labels positioned at the angular midpoint of their flavors ───
    # Group the actual theta angles of each flavor by its flavor_category
    cat_groups = {}
    for i, cat in enumerate(cats):
        if not cat:
            continue
        cat_groups.setdefault(cat, []).append(thetas[i])

    annotations = []

    max_r = max(richness) if richness else 10
    radial_range_max = max_r + 1.5
    wheel_half = 0.44  # paper-coord half-radius of the polar area

    for cat, angles in cat_groups.items():
        mid_angle = (min(angles) + max(angles)) / 2
        mid_rad   = math.radians(mid_angle - 90)
        label_r   = wheel_half * (radial_range_max / (radial_range_max + 1.0))
        annotations.append(dict(
            x=0.5 + label_r * math.cos(mid_rad),
            y=0.5 - label_r * math.sin(mid_rad),
            xref='paper', yref='paper',
            text=f'<b>{cat}</b>',
            showarrow=False,
            font=dict(size=18, family='Segoe UI Black, Arial Black, sans-serif',
                      color=get_category_color_by_name(cat)),
            bgcolor='rgba(0,0,0,0)',
            borderpad=4,
            xanchor='center',
            yanchor='middle',
        ))

    # ── No legend in figure — handled by toggles in layout ───────────────────
    shapes = []

    fig.update_layout(
        polar=dict(
            radialaxis=dict(visible=False, range=[0, radial_range_max]),
            angularaxis=dict(
                tickmode='array',
                tickvals=[],
                ticktext=[],
                direction='clockwise',
                rotation=90,
            ),
            bgcolor='rgba(0,0,0,0)',
            hole=0.07,
            domain=dict(x=[0.04, 0.96], y=[0.04, 0.96]),
        ),
        showlegend=False,
        margin=dict(l=20, r=20, t=20, b=20),
        autosize=True,
        paper_bgcolor='rgba(0,0,0,0)',
        plot_bgcolor='white',
        clickmode='event',
        shapes=shapes,
        annotations=annotations,
    )

    return fig


