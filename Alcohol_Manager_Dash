    if not n_clicks:
        raise PreventUpdate

    # ── Load data (cache-first) ──────────────────────────────────────────────
    try:
        df = get_all_data_as_df()
    except Exception:
        return html.P("Could not load collection data.", className="text-danger text-center"), ""

    if df.empty:
        return html.P("No bottles found in collection.", className="text-muted text-center"), ""

    # Keep only in-stock whisky bottles (hard filter — no red wine, bourbon, etc.)
    WHISKY_TYPES = {'Single Malt Whisky', 'Blended Scotch Whisky', 'Blended Malt', 'Single Grain', 'Blended Grain'}
    work = df.copy()
    if 'alcohol_type' in work.columns:
        work = work[work['alcohol_type'].isin(WHISKY_TYPES)]
    if 'stock_status_per' in work.columns:
        work = work[work['stock_status_per'].fillna(0) > 0]

    # ── Fallback: compute missing richness/smoky_sweet scores from nose+palette ──
    # Some bottles have NULL in the view — fill them in using the Python scorer
    for col_r, col_s in [('final_richness_score', 'final_smoky_sweet_score')]:
        if col_r in work.columns and col_s in work.columns:
            null_mask = work[col_r].isna() | work[col_s].isna()
            if null_mask.any() and 'nose' in work.columns and 'palette' in work.columns:
                for idx in work[null_mask].index:
                    row = work.loc[idx]
                    try:
                        fr, fs = compute_flavor_scores_from_flavors(
                            row.get('nose') or [],
                            row.get('palette') or [],
                            row.get('alcohol_percentage') or 43.0
                        )
                        if fr is not None:
                            work.at[idx, col_r] = fr
                        if fs is not None:
                            work.at[idx, col_s] = fs
                    except Exception:
                        pass

    # ── Scoring weights: Flavor 40%, Body 30%, ABV 20%, Type 10% ────────────
    scores = pd.Series(0.0, index=work.index)

    # — Flavor score (40%) ───────────────────────────────────────────────────
    if sel_flavors and 'final_smoky_sweet_score' in work.columns:
        flavor_score = pd.Series(0.0, index=work.index)
        for cat in sel_flavors:
            lo, hi = SWEETNESS_RANGES.get(cat, (0, 0))
            in_range = work['final_smoky_sweet_score'].dropna().between(lo, hi, inclusive='both')
            flavor_score = flavor_score.add(in_range.reindex(flavor_score.index, fill_value=False).astype(float))
        flavor_score = (flavor_score / max(len(sel_flavors), 1)) * 10
        scores += flavor_score * 0.40

    # — Body score (30%) ─────────────────────────────────────────────────────
    if sel_body and 'final_richness_score' in work.columns:
        body_score = pd.Series(0.0, index=work.index)
        for cat in sel_body:
            lo, hi = RICHNESS_RANGES.get(cat, (0, 0))
            in_range = work['final_richness_score'].dropna().between(lo, hi, inclusive='both')
            body_score = body_score.add(in_range.reindex(body_score.index, fill_value=False).astype(float))
        body_score = (body_score / max(len(sel_body), 1)) * 10
        scores += body_score * 0.30

    # — ABV score (20%) — supports multiple selections ──────────────────────
    sel_abv_list = sel_abv if isinstance(sel_abv, list) else ([sel_abv] if sel_abv else [])
    if sel_abv_list and 'alcohol_percentage' in work.columns:
        abv_score = pd.Series(0.0, index=work.index)
        for abv_key in sel_abv_list:
            abv_lo, abv_hi = _ABV_RANGES.get(abv_key, (0, 100))
            abv_score += work['alcohol_percentage'].between(abv_lo, abv_hi, inclusive='both').astype(float)
        abv_score = (abv_score / max(len(sel_abv_list), 1)) * 10
        scores += abv_score * 0.20

    # — Type score (10%) — hard-filtered above, give full points if type matches
    if sel_type and 'alcohol_type' in work.columns:
        type_match = (work['alcohol_type'] == sel_type).astype(float) * 10
        scores += type_match * 0.10

    work = work.copy()
    work['_som_score'] = scores

    top5 = work.nlargest(5, '_som_score')

    if top5.empty:
        return html.P("No matching bottles found — try broadening your selections.",
                      className="text-muted text-center"), ""

    # ── Build result cards ───────────────────────────────────────────────────
    # Normalize against dimensions actually selected (not fixed 10.0 max)
    # Each selected dimension contributes its weight × 10 to max_possible
    max_possible = 0.0
    if sel_flavors:       max_possible += 0.40 * 10
    if sel_body:          max_possible += 0.30 * 10
    if sel_abv_list:      max_possible += 0.20 * 10
    if sel_type:          max_possible += 0.10 * 10
    if max_possible == 0: max_possible = 1.0

    top_actual = top5['_som_score'].max()
    all_zero = top_actual == 0.0

    cards = []
    for rank, (_, row) in enumerate(top5.iterrows(), 1):
        raw = row['_som_score']
        if all_zero:
            score_pct = max(0, 60 - (rank - 1) * 10)
        else:
            score_pct = round((raw / max_possible) * 100)
            score_pct = min(score_pct, 100)
        name = row.get('bottle_name', '—')
        distillery = row.get('distillery', '')
        region = row.get('region', '')
        abv_val = row.get('alcohol_percentage', None)
        alc_type = row.get('alcohol_type', '')
        richness_lbl = get_richness_label(row['final_richness_score']) \
            if 'final_richness_score' in row and row.get('final_richness_score') is not None \
            else '—'
        sweet_lbl = get_sweetness_label(row['final_smoky_sweet_score']) \
            if 'final_smoky_sweet_score' in row and row.get('final_smoky_sweet_score') is not None \
            else '—'

        meta_parts = [p for p in [distillery, region, alc_type] if p]
        meta_str = ' · '.join(meta_parts)
        abv_str = f"{abv_val:.1f}%" if abv_val else '—'

        bar_color = '#2ecc71' if score_pct >= 80 else ('#f39c12' if score_pct >= 50 else '#e74c3c')

        cards.append(
            dbc.Card(
                dbc.CardBody([
                    dbc.Row([
                        # Rank badge
                        dbc.Col(
                            html.Div(str(rank), className="fw-bold text-center",
                                     style={
                                         'width': '36px', 'height': '36px',
                                         'borderRadius': '50%',
                                         'background': '#FFF3CD',
                                         'color': '#856404',
                                         'lineHeight': '36px',
                                         'fontSize': '16px',
                                         'flexShrink': '0',
                                     }),
                            width="auto", className="d-flex align-items-center"
                        ),
                        # Name + meta
                        dbc.Col([
                            html.Div(name, className="fw-semibold", style={'fontSize': '15px'}),
                            html.Div(meta_str, className="text-muted small"),
                            html.Div([
                                dbc.Badge(abv_str, color="secondary", className="me-1"),
                                dbc.Badge(richness_lbl, color="info", className="me-1"),
                                dbc.Badge(sweet_lbl, color="warning", className="me-1"),
                            ], className="mt-1"),
                            # Match bar
                            html.Div([
                                html.Div(style={
                                    'height': '4px',
                                    'width': f'{score_pct}%',
                                    'background': bar_color,
                                    'borderRadius': '2px',
                                    'transition': 'width .4s ease',
                                })
                            ], style={
                                'background': '#eee', 'borderRadius': '2px',
                                'marginTop': '6px', 'height': '4px'
                            }),
                        ]),
                        # Score
                        dbc.Col(
                            html.Div(f"{score_pct}%", className="fw-bold text-end",
                                     style={'fontSize': '15px', 'color': bar_color}),
                            width="auto", className="d-flex align-items-center"
                        ),
                    ], align="center"),
                ]),
                className="mb-3",
                style={'borderRadius': '12px'},
            )
        )

    _abv_parts = [f"{_ABV_RANGES[k][0]}–{_ABV_RANGES[k][1]}%" for k in (sel_abv_list or []) if k in _ABV_RANGES]
    _abv_str = ', '.join(_abv_parts) if _abv_parts else 'Any'
    subtitle = (
        f"Matched {len(sel_flavors or [])} flavor note(s), "
        f"{len(sel_body or [])} texture preference(s), "
        f"ABV {_abv_str} · "
        f"{sel_type or 'Any type'}"
    )

    return cards, subtitle


if __name__ == '__main__':
    app.run(debug=True, host="0.0.0.0", port=8051)
