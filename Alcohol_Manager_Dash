import math as _math
import re as _re

def _clamp(x, lo, hi):
    return max(lo, min(hi, x))

def _interp_hex(c1, c2, t):
    c1, c2 = c1.lstrip('#'), c2.lstrip('#')
    r1,g1,b1 = int(c1[0:2],16), int(c1[2:4],16), int(c1[4:6],16)
    r2,g2,b2 = int(c2[0:2],16), int(c2[2:4],16), int(c2[4:6],16)
    r = int(r1 + (r2-r1)*t)
    g = int(g1 + (g2-g1)*t)
    b = int(b1 + (b2-b1)*t)
    return f'#{r:02x}{g:02x}{b:02x}'

def _is_dark_bg(hex_color):
    h = hex_color.lstrip('#')
    r,g,b = int(h[0:2],16), int(h[2:4],16), int(h[4:6],16)
    return (0.299*r + 0.587*g + 0.114*b) < 140

def _lerp_color_by_stops(score, stops):
    s = float(score)
    if s <= stops[0][0]: return stops[0][1]
    if s >= stops[-1][0]: return stops[-1][1]
    for (v0,c0),(v1,c1) in zip(stops, stops[1:]):
        if v0 <= s <= v1:
            t = (s-v0)/(v1-v0) if v1 != v0 else 0.0
            return _interp_hex(c0, c1, _clamp(t, 0.0, 1.0))
    return stops[-1][1]

def _safe_float(x):
    if x is None: return None
    try:
        if isinstance(x, float) and _math.isnan(x): return None
    except Exception: pass
    if isinstance(x, (int, float)): return float(x)
    nums = _re.findall(r"[-+]?\d*\.?\d+", str(x).strip())
    return float(nums[-1]) if nums else None

def get_sweetness_label(score: float) -> str:
    items = list(SWEETNESS_RANGES.items())
    for i, (label, (low, high)) in enumerate(items):
        if low <= score <= high:
            return label
    return "Out of range"

def get_richness_label(score: float) -> str:
    for label, (low, high) in RICHNESS_RANGES.items():
        if low <= score <= high:
            return label
    return "Out of range"

