    [
        Output('new-nose-dropdown', 'value', allow_duplicate=True),
        Output('new-nose-dropdown', 'options', allow_duplicate=True),
        Output('new-palette-dropdown', 'value', allow_duplicate=True),
        Output('new-palette-dropdown', 'options', allow_duplicate=True),
    ],
    Input('aroma-wheel-graph', 'clickData'),
    [
        State('aroma-wheel-target', 'value'),
        State('new-nose-dropdown', 'value'),
        State('new-nose-dropdown', 'options'),
        State('new-palette-dropdown', 'value'),
        State('new-palette-dropdown', 'options'),
    ],
    prevent_initial_call=True
)
def handle_wheel_click(click_data, targets, nose_val, nose_opts, pal_val, pal_opts):
    if not click_data:
        raise PreventUpdate

    try:
        # customdata is (name, category) tuple
        cd = click_data['points'][0]['customdata']
        clicked_flavor = cd[0] if isinstance(cd, (list, tuple)) else cd
    except (KeyError, IndexError, TypeError):
        raise PreventUpdate

    if not clicked_flavor:
        raise PreventUpdate

    targets = targets or []

    def ensure_option(opts, flavor):
        opts = list(opts or [])
        existing = {o['value'] for o in opts}
        if flavor not in existing:
            opts.append({'label': flavor, 'value': flavor})
        return opts

    new_nose_val  = list(nose_val or [])
    new_nose_opts = list(nose_opts or [])
    new_pal_val   = list(pal_val or [])
    new_pal_opts  = list(pal_opts or [])

    currently_in_nose    = clicked_flavor in new_nose_val
    currently_in_palette = clicked_flavor in new_pal_val

    if 'nose' in targets:
        new_nose_opts = ensure_option(new_nose_opts, clicked_flavor)
        if currently_in_nose:
            new_nose_val.remove(clicked_flavor)
        else:
            new_nose_val.append(clicked_flavor)

    if 'palette' in targets:
        new_pal_opts = ensure_option(new_pal_opts, clicked_flavor)
        if currently_in_palette:
            new_pal_val.remove(clicked_flavor)
        else:
            new_pal_val.append(clicked_flavor)

    return new_nose_val, new_nose_opts, new_pal_val, new_pal_opts


