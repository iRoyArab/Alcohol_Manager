# 2c. UPD WHEEL: click on wheel → update upd-nose / upd-palette stores
def _ensure_option(opts, flavor):
    existing = set()
    for o in opts:
        v = o.get('value')
        if isinstance(v, (str, int, float)):
            existing.add(v)
    if flavor not in existing:
        opts = [{'label': flavor, 'value': flavor}] + list(opts)
    return opts

@app.callback(
    Output('upd-nose', 'value', allow_duplicate=True),
    Output('upd-nose', 'options', allow_duplicate=True),
    Output('upd-palette', 'value', allow_duplicate=True),
    Output('upd-palette', 'options', allow_duplicate=True),
    Output('upd-aroma-wheel-graph', 'figure', allow_duplicate=True),
    Input('upd-aroma-wheel-graph', 'clickData'),
    State('upd-aroma-wheel-target', 'value'),
    State('upd-nose', 'value'),
    State('upd-nose', 'options'),
    State('upd-palette', 'value'),
    State('upd-palette', 'options'),
    prevent_initial_call=True
)
def upd_handle_wheel_click(click_data, targets, nose_val, nose_opts, pal_val, pal_opts):
    if not click_data:
        raise PreventUpdate
    try:
        pt = click_data['points'][0]
        # customdata is always (flavor_name, category) — take index 0
        cd = pt.get('customdata')
        if cd is not None:
            clicked_flavor = cd[0] if isinstance(cd, (list, tuple)) else str(cd)
        else:
            raise PreventUpdate
        clicked_flavor = str(clicked_flavor).strip()
        if not clicked_flavor:
            raise PreventUpdate
    except (KeyError, IndexError, TypeError):
        raise PreventUpdate

    new_nose_val = list(nose_val or [])
    new_nose_opts = list(nose_opts or [])
    new_pal_val = list(pal_val or [])
    new_pal_opts = list(pal_opts or [])

    in_nose    = clicked_flavor in new_nose_val
    in_palette = clicked_flavor in new_pal_val
    both_targeted = 'nose' in (targets or []) and 'palette' in (targets or [])

    if both_targeted:
        # BOTH mode: if already in both → remove from both. Otherwise → add to whichever is missing.
        if in_nose and in_palette:
            new_nose_val.remove(clicked_flavor)
            new_pal_val.remove(clicked_flavor)
        else:
            if not in_nose:
                new_nose_opts = _ensure_option(new_nose_opts, clicked_flavor)
                new_nose_val.append(clicked_flavor)
            if not in_palette:
                new_pal_opts = _ensure_option(new_pal_opts, clicked_flavor)
                new_pal_val.append(clicked_flavor)
    else:
        if 'nose' in (targets or []):
            new_nose_opts = _ensure_option(new_nose_opts, clicked_flavor)
            if in_nose:
                new_nose_val.remove(clicked_flavor)
            else:
                new_nose_val.append(clicked_flavor)

        if 'palette' in (targets or []):
            new_pal_opts = _ensure_option(new_pal_opts, clicked_flavor)
            if in_palette:
                new_pal_val.remove(clicked_flavor)
            else:
                new_pal_val.append(clicked_flavor)

    flavors = flavors_df[['flavor_name', 'richness_score', 'smoky_sweet_score', 'flavor_category']].to_dict('records')
    fig = build_aroma_wheel_figure(flavors, new_nose_val, new_pal_val)
    return new_nose_val, new_nose_opts, new_pal_val, new_pal_opts, fig


