# 6. EXECUTE UPDATE (v101 — fast: no scripting, Python-driven logic)
@app.callback(
    [Output('alert-output', 'children'),
     Output('alert-output', 'is_open'),
     Output('alert-output', 'color'),
     Output('update-selector', 'value', allow_duplicate=True),
     Output('stock-slider', 'value', allow_duplicate=True),
     Output('upd-nose-manual', 'value'),
     Output('upd-palette-manual', 'value'),
     Output('btn-enable-edit', 'n_clicks')],
    Input('confirm-update-btn', 'n_clicks'),
    [State('bottle-meta-store', 'data'),
     State('stock-slider', 'value'),
     State('upd-nose', 'value'),
     State('upd-palette', 'value'),
     State('upd-abv', 'value'),
     State('upd-nose-manual', 'value'),
     State('upd-palette-manual', 'value'),
     State('glass-count', 'value'),
     State('drinker-pour', 'value'),
     State('drinker-pour-manual', 'value')],
    prevent_initial_call=True
)
def execute_update(n, meta, stock, nose, palette, abv, nose_man, pal_man, glasses_cnt, drinkers, drinker_man):

    if not n or not meta or not client:
        return no_update, no_update, no_update, no_update, no_update, no_update, no_update, no_update

    try:
        from datetime import date as _date, datetime as _datetime

        # ---- Merge arrays ----
        final_nose = list(nose) if nose else []
        if nose_man:
            final_nose.extend([x.strip() for x in str(nose_man).split(',') if x.strip()])

        final_palette = list(palette) if palette else []
        if pal_man:
            final_palette.extend([x.strip() for x in str(pal_man).split(',') if x.strip()])

        def sql_array(arr):
            if not arr:
                return "[]"
            safe = [f"'{str(x).replace(chr(39), chr(92)+chr(39))}'" for x in arr]
            return f"[{', '.join(safe)}]"

        sql_nose    = sql_array(final_nose)
        sql_palette = sql_array(final_palette)

        stock_val    = float(stock)
        is_empty     = (stock_val == 0.0)
        sql_abv      = float(abv) if abv is not None else float(meta['orig_abv'])
        drams_to_add = int(glasses_cnt or 0)

        final_drinkers = list(drinkers) if drinkers else []
        if drinker_man:
            final_drinkers.extend([x.strip() for x in str(drinker_man).split(',') if x.strip()])
        sql_drinkers = (
            "[" + ", ".join(f"'{str(d).replace(chr(39), chr(92)+chr(39))}'" for d in final_drinkers) + "]"
            if final_drinkers else "[]"
        )

        safe_name = str(meta['name']).replace("'", "\\'")
        bid       = int(meta['bid'])
        today     = _date.today()

        # ── Step 1: Pre-fetch forecast data in Python (1 small query, no scripting) ──
        forecast_rows = list(client.query(f"""
            SELECT bottle_id,
                   DATE(est_consumption_date)  AS ec,
                   DATE(predicted_finish_date) AS pf
            FROM `{FORECAST_TABLE_REF}`
            WHERE DATE(est_consumption_date)  = '{today}'
               OR DATE(predicted_finish_date) = '{today}'
        """).result())

        consumption_match = any(r.ec == today for r in forecast_rows)
        forecasted_bid    = next((r.bottle_id for r in forecast_rows if r.ec == today), None)
        depletion_match   = is_empty and any(r.pf == today for r in forecast_rows)

        consumption_flag_str = 'True' if consumption_match else 'False'
        depletion_flag_str   = 'True' if depletion_match   else 'False'
        forecasted_bid_sql   = str(forecasted_bid) if forecasted_bid is not None else 'NULL'

        # ── Step 2: Pre-fetch next update_id in Python (1 tiny query) ──
        id_rows  = list(client.query(f"SELECT COALESCE(MAX(update_id), 0) + 1 AS next_id FROM `{HISTORY_TABLE_REF}`").result())
        next_id  = int(id_rows[0].next_id) if id_rows else 1

        upd_ts_str = _datetime.now().strftime('%Y-%m-%d %H:%M:%S') + ' UTC'

        if stock == 100:
        # ── Step 3: UPDATE main table (simple DML — no scripting) ──
            sql_update = f"""
                UPDATE `{TABLE_REF}`
                SET stock_status_per   = {stock_val},
                    full_or_empy       = {str(is_empty).lower()},
                    updating_time      = TIMESTAMP('{upd_ts_str}'),
                    nose               = {sql_nose},
                    palette            = {sql_palette},
                    alcohol_percentage = {sql_abv},
                    opening_date       = DATE('{today}')
                WHERE bottle_id = {bid}
            """
            client.query(sql_update).result()
            
        else:
            sql_update = f"""
                UPDATE `{TABLE_REF}`
                SET stock_status_per   = {stock_val},
                    full_or_empy       = {str(is_empty).lower()},
                    updating_time      = TIMESTAMP('{upd_ts_str}'),
                    alcohol_percentage = {sql_abv}
                WHERE bottle_id = {bid}
            """
            client.query(sql_update).result()            
        

        # ── Step 4: INSERT history row (simple DML — no scripting) ──
        sql_insert = f"""
            INSERT INTO `{HISTORY_TABLE_REF}`
            (update_id, bottle_id, bottle_name, stock_status_per, update_time,
             nose, palette, alc_pre, drams_counter,
             consumption_flag, depletion_flag, forecasted_bottle_id, drinker_name)
            VALUES (
                {next_id},
                {bid},
                '{safe_name}',
                {stock_val},
                TIMESTAMP('{upd_ts_str}'),
                {sql_nose},
                {sql_palette},
                {sql_abv},
                {drams_to_add},
                '{consumption_flag_str}',
                '{depletion_flag_str}',
                {forecasted_bid_sql},
                {sql_drinkers}
            )
        """
        client.query(sql_insert).result()

        # ── Invalidate caches ──
        CACHE_DATA['last_update']    = 0
        CACHE_HISTORY['last_update'] = 0

        return (
            f"✅ Updated {meta['name']}! (+{drams_to_add} drams)",
            True,
            "success",
            bid,
            100,
            "",
            "",
            0
        )

    except Exception as e:
        import traceback
        traceback.print_exc()
        return f"❌ Update failed: {e}", True, "danger", no_update, no_update, no_update, no_update, no_update


