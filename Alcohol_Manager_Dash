def random_dram(n_random, n_personal, mode, selected_drinkers):
    triggered = ctx.triggered_id
    _HIDE  = {"overflowX": "auto", "display": "none"}
    _SHOW  = {"overflowX": "auto"}
    NO5    = (no_update, no_update, no_update, no_update, no_update)
    if not triggered:
        return NO5

    # ── PERSONALIZED MODE ──────────────────────────────────────────────────────
    if triggered == 'btn-personalized-dram':
        if not selected_drinkers:
            return (dbc.Alert("Please select a drinker!", color="danger", className="mt-1 py-2 small"),
                    no_update, [], _HIDE, "")

        try:
            df_all = get_all_data_as_df()
            dfh    = get_history_as_df()

            if df_all is None or df_all.empty or dfh is None or dfh.empty:
                return (dbc.Alert("No data available.", color="warning", className="mt-1 py-2 small"),
                        no_update, [], _HIDE, "")

            # Step 1: taste profile — history filtered by drinker + 120 days
            cutoff_120   = pd.Timestamp.now() - pd.Timedelta(days=120)
            selected_set = set(selected_drinkers)

            def _norm_ts(t):
                t2 = pd.to_datetime(t)
                try:
                    if t2.tzinfo is not None:
                        t2 = t2.replace(tzinfo=None)
                except Exception:
                    pass
                return t2

            mask_drinker = dfh['drinker_name'].apply(
                lambda names: bool(selected_set & set(names)) if isinstance(names, list) else (names in selected_set)
            )
            mask_date    = dfh['update_time'].apply(lambda t: _norm_ts(t) >= cutoff_120 if pd.notna(t) else False)
            dfh_filtered = dfh[mask_drinker & mask_date].drop_duplicates(subset=['bottle_id', 'update_time'])

            if dfh_filtered.empty:
                return (dbc.Alert("No drinking history found for selected drinker(s) in the last 120 days.",
                                  color="warning", className="mt-1 py-2 small"),
                        no_update, [], _HIDE, "")

            flavor_cols = ['bottle_id', 'final_richness_score', 'final_smoky_sweet_score']
            available   = [c for c in flavor_cols if c in df_all.columns]
            # Keep update_time from history side before merging with catalogue
            hist_cols = ['bottle_id', 'update_time'] + [c for c in ['final_richness_score', 'final_smoky_sweet_score'] if c in dfh_filtered.columns]
            # Deduplicate df_all BEFORE merge to prevent row explosion from VIEW duplicates
            df_all_dedup = df_all[available].groupby('bottle_id', as_index=False).first()
            joined = dfh_filtered[['bottle_id', 'update_time']].drop_duplicates().merge(
                df_all_dedup, on='bottle_id', how='inner'
            )

            # Drop non-whisky bottles (no flavor scores in VIEW)
            joined = joined.dropna(subset=['final_richness_score', 'final_smoky_sweet_score'])

            if joined.empty or 'final_richness_score' not in joined.columns:
                return (dbc.Alert("Not enough flavor data to build taste profile.",
                                  color="warning", className="mt-1 py-2 small"),
                        no_update, [], _HIDE, "")

            # ── Profile: Mode-of-category for richness, recent-60%-median for sweetness ──
            # Normalize update_time (strip timezone) before sorting
            joined['update_time'] = pd.to_datetime(joined['update_time']).apply(
                lambda t: t.replace(tzinfo=None) if pd.notna(t) and hasattr(t, 'tzinfo') and t.tzinfo is not None else t
            )
            joined_sorted = joined.sort_values('update_time').reset_index(drop=True)
            n_sessions    = len(joined_sorted)

            # Richness: find most frequent category → use its center point
            def _get_cat(val, ranges_dict):
                for label, (lo, hi) in ranges_dict.items():
                    if lo <= val <= hi:
                        return label
                return None

            def _cat_center(label, ranges_dict):
                lo, hi = ranges_dict[label]
                hi = min(hi, 30.0)  # cap open-ended top bucket
                return (lo + hi) / 2.0

            joined_sorted['r_cat'] = joined_sorted['final_richness_score'].apply(
                lambda v: _get_cat(v, RICHNESS_RANGES)
            )
            mode_r_cat = joined_sorted['r_cat'].value_counts().idxmax()
            richness_avg = _cat_center(mode_r_cat, RICHNESS_RANGES)

            # Sweetness: median of most recent 60% of sessions
            cutoff_idx    = int(np.ceil(n_sessions * 0.4))
            recent_joined = joined_sorted.iloc[cutoff_idx:]
            sweet_smoke_avg = recent_joined['final_smoky_sweet_score'].median()

            # Step 2: exclude bottles drunk in the last 21 days by selected drinkers
            cutoff_21 = pd.Timestamp.now() - pd.Timedelta(days=21)
            mask_recent = dfh['update_time'].apply(lambda t: _norm_ts(t) >= cutoff_21 if pd.notna(t) else False)
            recently_drunk_ids = set(dfh[mask_drinker & mask_recent]['bottle_id'].tolist())

            # Step 3: vectorised distance on full catalogue (exclude empty bottles)
            catalogue = df_all.copy()
            catalogue = catalogue[~catalogue['bottle_id'].isin(recently_drunk_ids)]
            catalogue = catalogue.dropna(subset=['final_richness_score', 'final_smoky_sweet_score'])
            catalogue = catalogue[catalogue['stock_status_per'].fillna(0) > 0]  # exclude empty

            if catalogue.empty:
                return (dbc.Alert("All bottles were drunk in the last 21 days!",
                                  color="warning", className="mt-1 py-2 small"),
                        no_update, [], _HIDE, "")

            def _category_width(score, ranges_dict):
                for label, (low, high) in ranges_dict.items():
                    if low <= score <= high:
                        return high - low
                return 1.0

            sweet_width = _category_width(sweet_smoke_avg, SWEETNESS_RANGES)
            rich_width  = _category_width(richness_avg,    RICHNESS_RANGES)

            catalogue['sweet_normalized'] = (catalogue['final_smoky_sweet_score'] - sweet_smoke_avg).abs() / sweet_width
            catalogue['rich_normalized']  = (catalogue['final_richness_score']    - richness_avg).abs()    / rich_width

            # Exponential penalty on sweetness (sensitive scale) + weighted sum
            catalogue['average_dis'] = (
                catalogue['sweet_normalized'] ** 2 * 0.7 +
                catalogue['rich_normalized']        * 0.3
            )

            # Step 4: priority — open (< 100%) = 1, sealed = 2
            catalogue['priority'] = np.where(catalogue['stock_status_per'].fillna(100) < 100, 1, 2)

            # Step 5: pick Top 3 with open-first / fallback logic
            open_sorted   = catalogue[catalogue['priority'] == 1].sort_values('average_dis')
            closed_sorted = catalogue[catalogue['priority'] == 2].sort_values('average_dis')

            FALLBACK_THRESHOLD = 2.5

            if open_sorted.empty:
                top3 = closed_sorted.head(3)
            else:
                best_open_dis = open_sorted.iloc[0]['average_dis']
                if (not closed_sorted.empty) and (best_open_dis > FALLBACK_THRESHOLD):
                    best_closed = closed_sorted.iloc[0]
                    if best_closed['average_dis'] < best_open_dis:
                        top3 = pd.concat([best_closed.to_frame().T, open_sorted.head(2)], ignore_index=True)
                    else:
                        top3 = open_sorted.head(3)
                else:
                    top3 = open_sorted.head(3)

            # Step 6: build DataTable rows
            medals = ["🥇", "🥈", "🥉"]
            rows   = []
            for i, (_, row) in enumerate(top3.iterrows()):
                stock_pct  = row.get('stock_status_per', '?')
                status_tag = "🟢 Open" if row.get('priority') == 1 else "🔒 Sealed"
                rows.append({
                    "medal":       medals[i] if i < len(medals) else str(i+1),
                    "distillery":  row.get('distillery', ''),
                    "bottle_name": row.get('bottle_name', ''),
                    "status":      f"{status_tag} {stock_pct}%",
                    "average_dis": f"{row['average_dis']:.2f}",
                    "bottle_id":   int(row.get('bottle_id', 0)),
                })

            header = html.Small(
                f"🎯 {', '.join(selected_drinkers)} | "
                f"richness ≈ {richness_avg:.1f} ({mode_r_cat}) | smoky-sweet ≈ {sweet_smoke_avg:.2f}",
                className="text-success"
            )
            return header, no_update, rows, _SHOW, "Click a row to load the bottle."

        except Exception as e:
            return (dbc.Alert(f"Error: {e}", color="danger", className="mt-1 py-2 small"),
                    no_update, [], _HIDE, "")

    # ── RANDOM MODE ────────────────────────────────────────────────────────────
    if triggered == 'btn-random-dram' and not n_random:
        return NO5

    df = get_all_data_as_df()
    if df is None or df.empty:
        return "No cached data yet.", no_update, [], _HIDE, ""

    try:
        dfh = get_history_as_df()

        now    = datetime.now()
        cutoff = now - timedelta(days=7)

        last_sip = {}
        if dfh is not None and not dfh.empty:
            try:
                grp      = dfh.groupby("bottle_id")["update_time"].max()
                last_sip = grp.to_dict()
            except Exception:
                pass

        eligible = df.copy()
        if "stock_status_per" in eligible.columns:
            eligible = eligible[eligible["stock_status_per"].fillna(0) > 0]
        if "alcohol_type" in eligible.columns:
            eligible = eligible[eligible["alcohol_type"].isin(['Single Malt Whisky', 'Blended Scotch Whisky'])]

        def ok_last(bid):
            t = last_sip.get(int(bid))
            if t is None or pd.isna(t):
                return True
            try:
                t2 = pd.to_datetime(t).to_pydatetime()
            except Exception:
                return True
            try:
                if getattr(t2, "tzinfo", None) is not None:
                    t2 = t2.astimezone(tz=None).replace(tzinfo=None)
            except Exception:
                pass
            return t2 < cutoff

        if "bottle_id" in eligible.columns:
            eligible = eligible[eligible["bottle_id"].apply(ok_last)]

        if eligible.empty:
            return "No eligible bottles!", no_update, [], _HIDE, ""

        choice  = eligible.sample(1).iloc[0]
        display = html.Div([
            html.H5(f"🥃 {choice.get('distillery','')} - {choice.get('bottle_name','')}", className="mb-0"),
            html.Small(f"ID: {int(choice.get('bottle_id'))} | {choice.get('region','')}")
        ])
        return display, int(choice.get("bottle_id")), [], _HIDE, ""

    except Exception as e:
        return f"Error: {e}", no_update, [], _HIDE, ""
