def _fmt_date(d):
    """Accepts date/datetime/str; returns YYYY-MM-DD or '-'."""
    if d is None or (isinstance(d, float) and pd.isna(d)):
        return "-"
    try:
        # pandas Timestamp / datetime / date
        if hasattr(d, "date"):
            return d.date().isoformat() if hasattr(d, "time") else d.isoformat()
    except Exception:
        pass
    try:
        return pd.to_datetime(d).date().isoformat()
    except Exception:
        return str(d)

