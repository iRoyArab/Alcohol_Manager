def fetch_rarity_options():
    """Fetch distinct rarity values from TABLE_REF sorted by rarity_score from FORECAST_TABLE_REF ascending."""
    if not client:
        return []
    query = f"""
    SELECT DISTINCT t1.rarity, COALESCE(MIN(t2.rarity_score), 9999) as rarity_score
    FROM `{TABLE_REF}` t1
    LEFT JOIN `{FORECAST_TABLE_REF}` t2 ON t1.bottle_id = t2.bottle_id
    WHERE t1.rarity IS NOT NULL
    GROUP BY 1
    ORDER BY rarity_score ASC
    """
    try:
        rows = list(client.query(query).result())
        return [
            {'label': row.rarity, 'value': row.rarity}
            for row in rows
            if row.rarity and str(row.rarity).strip()  # double-safety on Python side
