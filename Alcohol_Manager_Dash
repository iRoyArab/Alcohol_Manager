def _do_insert(dropdowns, inputs, age, abv, price, disc_price,
               limited, special, gift, discounted, purch, opening,
               stock, qty, rarity, num_dyn):
    """Shared insert logic — uses DML INSERT via client.query() so rows are
    immediately mutable (UPDATE/DELETE) without waiting for streaming buffer flush."""

    def resolve(drop, inp, multi=False):
        if multi:
            if not drop: return []
            base = [v for v in drop if v != 'ADD_NEW_OPTION'] if isinstance(drop, list) and 'ADD_NEW_OPTION' in drop else (drop or [])
            if inp:
                base.extend([x.strip() for x in inp.split(',') if x.strip()])
            return [str(x).replace("'", "\\'") for x in base]
        val = inp if drop == 'ADD_NEW_OPTION' else drop
        if isinstance(val, str):
            return val.replace("'", "\\'")
        return val

    def bq_str(v):
        """Wrap a Python string as a BigQuery string literal, or NULL."""
        if v is None:
            return "NULL"
        return "'" + str(v).replace("'", "\\'") + "'"

    def bq_arr(lst):
        """Render a Python list as a BigQuery ARRAY<STRING> literal."""
        if not lst:
            return "[]"
        items = ", ".join("'" + str(x).replace("'", "\\'") + "'" for x in lst)
        return f"[{items}]"

    def bq_num(v):
        return str(v) if v is not None else "NULL"

    def bq_bool(v):
        return "TRUE" if v else "FALSE"

    def bq_date(v):
        return f"DATE '{v}'" if v else "NULL"

    try:
        qty = int(qty or 1)
        now_str = datetime.now().strftime("%Y-%m-%dT%H:%M:%S.%f") + " UTC"

        # ── 1. Get current MAX IDs (2 fast queries) ────────────────────────────
        r_bottle = list(client.query(f"SELECT COALESCE(MAX(bottle_id), 0) AS m FROM `{TABLE_REF}`").result())
        r_hist   = list(client.query(f"SELECT COALESCE(MAX(update_id), 0) AS m FROM `{HISTORY_TABLE_REF}`").result())
        start_id  = int(r_bottle[0].m)
        start_uid = int(r_hist[0].m)

        # ── 2. Resolve field values once (same for all qty copies) ─────────────
        val_name         = resolve(dropdowns[0], inputs[0])
        val_dist         = resolve(dropdowns[1], inputs[1]) or ''
        val_type         = resolve(dropdowns[2], inputs[2]) or ''
        val_country      = resolve(dropdowns[3], inputs[3]) or ''
        val_region       = resolve(dropdowns[4], inputs[4]) or ''
        val_casks        = resolve(dropdowns[5], inputs[5], True)
        val_nose         = resolve(dropdowns[6], inputs[6], True)
        val_pal          = resolve(dropdowns[7], inputs[7], True)
        val_vol          = int(resolve(dropdowns[8], inputs[8]) or 700)
        val_discount_amt = resolve(dropdowns[9], inputs[9])
        val_rarity       = str(rarity) if rarity else None

        # ── 3. Build & execute DML INSERT rows ────────────────────────────────
        # Rows are written directly to BQ managed storage — immediately mutable.
        main_value_rows = []
        hist_value_rows = []

        for i in range(1, qty + 1):
            bid = start_id + i
            uid = start_uid + i
            main_value_rows.append(f"""(
                {bid},
                {bq_str(val_name)},
                {bq_str(val_dist)},
                {bq_str(val_type)},
                {bq_str(val_country)},
                {bq_str(val_region)},
                {bq_arr(val_casks)},
                {bq_arr(val_nose)},
                {bq_arr(val_pal)},
                {bq_num(int(age) if age else None)},
                {bq_num(float(abv) if abv else None)},
                {bq_num(float(price) if price else None)},
                {bq_bool(limited)},
                {bq_bool(special)},
                {bq_bool(gift)},
                {bq_num(float(stock))},
                {bq_bool(stock == 0)},
                {bq_num(val_vol)},
                {bq_date(purch)},
                {bq_date(opening)},
                1,
                {bq_bool(discounted)},
                {bq_num(float(val_discount_amt) if val_discount_amt else None)},
                {bq_num(float(disc_price) if disc_price else None)},
                TIMESTAMP '{now_str}',
                {bq_str(val_rarity)}
            )""")
            hist_value_rows.append(f"""(
                {uid},
                {bid},
                {bq_str(val_name)},
                {bq_num(float(stock))},
                TIMESTAMP '{now_str}',
                {bq_arr(val_nose)},
                {bq_arr(val_pal)},
                {bq_num(float(abv) if abv else None)}
            )""")

        sql_main = f"""
            INSERT INTO `{TABLE_REF}`
            (bottle_id, bottle_name, distillery, alcohol_type, origin_country, region,
             casks_aged_in, nose, palette, age, alcohol_percentage, price,
             limited_edition, special_bottling, was_a_gift, stock_status_per,
             full_or_empy, orignal_volume, date_of_purchase, opening_date,
             bottle_counter, was_discounted, discount_amount, discounted_price,
             time_of_registration, rarity)
            VALUES {', '.join(main_value_rows)}
        """
        sql_hist = f"""
            INSERT INTO `{HISTORY_TABLE_REF}`
            (update_id, bottle_id, bottle_name, stock_status_per, update_time,
             nose, palette, alc_pre)
            VALUES {', '.join(hist_value_rows)}
        """

        # ── 4. Execute both DML statements (rows immediately mutable after) ────
        client.query(sql_main).result()
        client.query(sql_hist).result()

        # ── 5. Invalidate cache + refresh dropdowns ───────────────────────────
        CACHE_DATA["df"] = None
        CACHE_DATA["last_update"] = 0
        new_list = fetch_bottle_list_optimized()
        new_opts = fetch_all_dropdown_data()
        opts_list = [new_opts.get(f, []) for f in DYNAMIC_FIELDS_BASE]
        reset = [None]*(num_dyn*2) + [None, None, None, None, None, None, 100, 1, None]

        return (f"✅ Added {qty} bottle(s)", True, "success", new_list,
                *reset, *opts_list,
                False, no_update, None,
                False, no_update)

    except Exception as e:
        import traceback
        traceback.print_exc()
        return (f"❌ Insert failed: {e}", True, "danger", no_update,
                *[no_update]*num_dyn*2,
                no_update, no_update, no_update, no_update,
                no_update, no_update, no_update, no_update, no_update,
                *[no_update]*num_dyn,
                False, no_update, no_update,
                False, no_update)


