import plotly.graph_objects as go

# Helper: build a polar segment wheel figure
def _build_sommelier_wheel(categories, selected, colors):
    """
    Build a Plotly barpolar figure for the sommelier step wheels.
    categories : list of str
    selected   : list of str (currently selected)
    colors     : list of hex color strings
    """
    n = len(categories)
    r_val = [1] * n
    theta = [i * (360 / n) for i in range(n)]
    width = [360 / n] * n

    bar_colors = []
    for i, cat in enumerate(categories):
        base = colors[i]
        if cat in selected:
            bar_colors.append(base)
        else:
            h = base.lstrip('#')
            r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
            bar_colors.append(f'rgba({r},{g},{b},0.25)')

    fig = go.Figure()


    for i, (cat, col) in enumerate(zip(categories, bar_colors)):
        fig.add_trace(go.Barpolar(
            r=[1],
            theta=[theta[i]],
            width=[360 / n - 2],
            base=[0],
            marker_color=[col],
            marker_line_color='white',
            marker_line_width=2,
            name=cat,
            customdata=[cat],
            hovertemplate='<b>%{customdata}</b><extra></extra>',

        ))

    fig.update_layout(
        polar=dict(
            radialaxis=dict(visible=False, range=[0, 1.2]),
            angularaxis=dict(
                showticklabels=True,
                tickvals=theta,
                ticktext=[f"<b>✦ {c}</b>" if c in selected else f"<b>{c}</b>" for c in categories],
                tickfont=dict(size=13, color='#333', family='Arial Black, Arial, sans-serif'),
                direction='clockwise',
                rotation=90,

            ),
            bgcolor='rgba(0,0,0,0)',
        ),
        showlegend=False,
        margin=dict(t=20, b=20, l=20, r=20),
        paper_bgcolor='rgba(0,0,0,0)',
        plot_bgcolor='rgba(0,0,0,0)',
        height=360,
        clickmode='event',
    )
    return fig


