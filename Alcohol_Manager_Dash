    unique_count = len([f for f in all_flavors if f in flavor_lookup])
    raw_richness   = sum(m['richness_score']   for m in matched) / unique_count
    raw_smoky_sweet = sum(m['smoky_sweet_score'] for m in matched) / unique_count

    # Flags
    rich       = any(m['richness_score'] == 8.0 for m in matched)
    super_rich = any(m['richness_score'] == 9.0 for m in matched)
    rich_joker  = any(f.lower() in ('butterscotch','marmalade','chocolate','coffee','espresso') for f in all_flavors)
    bitter      = any(f.lower() in ('dark chocolate','coffee','espresso','mocha','tiramisu') for f in all_flavors)
    light_smoke = any(f.lower() in ('minerals','sulfur','meaty','chalk','metalic') for f in all_flavors)

    # PenalizedStats
    base_richness = (raw_richness * 0.7 if unique_count < 4 else raw_richness)
    base_richness *= (1.3 if rich else 1.0) * (1.55 if super_rich else 1.0) * (1.4 if rich_joker else 1.0)

    base_smoky_sweet = (raw_smoky_sweet * 0.7 if unique_count <= 4 else raw_smoky_sweet)
    base_smoky_sweet *= (1.25 if bitter else 1.0) * (1.4 if light_smoke else 1.0)

    # ABV multipliers — richness
    if   40 <= abv < 48:  fr = base_richness * 0.9
    elif 48 <= abv < 54:  fr = base_richness * 1.1
    elif 54 <= abv < 59:  fr = base_richness * 1.25
    elif 59 <= abv < 65:  fr = base_richness * 1.4
    elif 65 <= abv < 71:  fr = base_richness * 1.5
    else:                 fr = base_richness

    # ABV multipliers — smoky/sweet
    if 40 <= abv < 47:
        fs = base_smoky_sweet * 0.7
    elif 47 <= abv < 54:
        fs = base_smoky_sweet * (0.8 if base_smoky_sweet < 5 else 1.1)
    elif 54 <= abv < 59:
        fs = base_smoky_sweet * (0.75 if base_smoky_sweet < 5 else 1.2)
    elif 59 <= abv < 65:
        fs = base_smoky_sweet * (0.65 if base_smoky_sweet < 5 else 1.45)
    elif 65 <= abv < 71:
        fs = base_smoky_sweet * (0.55 if base_smoky_sweet < 5 else 1.5)
    else:
        fs = base_smoky_sweet

    return round(fr, 2), round(fs, 2)


