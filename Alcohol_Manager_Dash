def fill_bb_top3_table(_n):
    df = get_all_data_as_df()
    if df is None or df.empty:
        return [], "No data loaded."

    needed = {"bottle_id", "distillery", "bottle_name", "Best_Before"}
    missing = needed - set(df.columns)
    if missing:
        return [], f"Missing columns: {', '.join(sorted(missing))}"

    tmp = df.copy()
    tmp["Best_Before"] = pd.to_datetime(tmp["Best_Before"], errors="coerce").dt.date
    tmp = tmp.dropna(subset=["Best_Before"])

    today = datetime.now().date()
    tmp["days_left"] = tmp["Best_Before"].apply(lambda d: (d - today).days if d else None)

    # רק חיובי, בלי שלילי/אפס/NULL
    tmp = tmp[tmp["days_left"].notna() & (tmp["days_left"] > 0)]

    if tmp.empty:
        return [], "No upcoming Best_Before dates found."

    top3 = tmp.nsmallest(3, "days_left")[["bottle_id", "distillery", "bottle_name", "Best_Before", "days_left"]]

    data = []
    for _, r in top3.iterrows():
        data.append({
            "bottle_id": int(r["bottle_id"]),
            "distillery": str(r["distillery"]),
            "bottle_name": str(r["bottle_name"]),
            "Best_Before": str(r["Best_Before"]),
            "days_left": int(r["days_left"]),
        })

    return data, "Tip: click a row to select the bottle."

